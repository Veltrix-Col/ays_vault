APP_ENV=development
DEBUG=True
TOOLS_ACCESS_MODE=local_public
# Ruta Python al validador aprobado de la intranet. Mantener vacía hasta que
# exista una especificación formal; trusted_intranet falla cerradamente.
TOOLS_DELEGATED_ACCESS_VALIDATOR=
SECRET_KEY=change-me-with-at-least-50-characters-in-production
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
DB_ENGINE=sqlite
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# Secreto aleatorio independiente para detección determinística de duplicados.
FIELD_FINGERPRINT_KEY=
OFFICE_START=07:00
OFFICE_END=18:00
ALERT_EMAIL=superior@ays.example
DEFAULT_FROM_EMAIL=alertas@ays.example

# Backend general de Django. En desarrollo debe permanecer en consola.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Servicio de notificaciones: console, smtp o graph.
ALERT_EMAIL_BACKEND=console
ALERT_EMAIL_FROM=alertas@ays.example
ALERT_EMAIL_ADMIN=administrador@ays.example
ALERT_EMAIL_LEADER=lider.cartera@ays.example

# SMTP Microsoft 365 con contraseña de aplicación. No use la contraseña normal.
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Microsoft Graph permanece disponible como alternativa futura.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER=
EMAIL_TIMEOUT_SECONDS=10
EMAIL_MAX_RETRIES=3
# Nunca suba .env a Git. Reciba y rote secretos únicamente mediante un canal seguro.
# SMTP requiere que el tenant y el buzón permitan SMTP autenticado y contraseñas de aplicación.
VAULT_BASE_URL=http://127.0.0.1:8000
SOAT_APP_URL=
# URL HTTPS del reporte fuente en Zoho que se muestra como enlace informativo.
SOAT_ZOHO_REPORT_URL=
SOAT_MAX_UPLOAD_BYTES=26214400
SOAT_MAX_ROWS=100000
SOAT_MAX_COLUMNS=200

# Conciliador de Facturación (módulo de conciliación de asegurados vs. cobro).
# Dejar CONCILIACION_APP_URL vacío para usar la ruta interna /conciliador/.
CONCILIACION_APP_URL=
CONCILIACION_MAX_UPLOAD_BYTES=26214400
# Diferencia en pesos por debajo de la cual una diferencia de prima cobrada vs.
# Zoho NO se reporta como incidente (ComparacionExactaRule).
CONCILIACION_UMBRAL_VALOR_EXACTO=10

# Validación del recibo (PDF) vía Azure Content Understanding. Por servicio hay
# un analyzer propio (salud, vida, movilidad): salud->ramo Salud,
# vida->VG Voluntario y VG Deudores, movilidad->ramo Movilidad. La KEY es un
# SECRETO: nunca se versiona; su ausencia degrada la validación a "N/D" sin
# romper la conciliación. Endpoint/analyzer/api_version tienen defaults no
# secretos; solo defínalos si su recurso difiere del de desarrollo.
AZURE_CU_SALUD_KEY=
AZURE_CU_SALUD_ENDPOINT=https://ays-cu-renovaciones-dev.services.ai.azure.com/
AZURE_CU_SALUD_ANALYZER_ID=ays_extractor_reporte_dev
AZURE_CU_SALUD_API_VERSION=2025-11-01
AZURE_CU_VIDA_KEY=
AZURE_CU_VIDA_ENDPOINT=https://ays-cu-renovaciones-dev.services.ai.azure.com/
AZURE_CU_VIDA_ANALYZER_ID=ays_extractor_reporte_dev
AZURE_CU_VIDA_API_VERSION=2025-11-01
AZURE_CU_MOVILIDAD_KEY=
AZURE_CU_MOVILIDAD_ENDPOINT=https://ays-cu-renovaciones-dev.services.ai.azure.com/
AZURE_CU_MOVILIDAD_ANALYZER_ID=ays_extractor_reporte_dev
AZURE_CU_MOVILIDAD_API_VERSION=2025-11-01
REPORT_XLSX_MAX_ROWS=5000
REPORT_PDF_MAX_ROWS=1000
REPORT_DEFAULT_MAX_DAYS=90
REPORT_LARGE_EXPORT_ALERT_THRESHOLD=1000
# Miniportal externo de Colectivos: vigencia funcional predeterminada de 48 horas.
COLECTIVOS_EXTERNAL_LINK_TTL_SECONDS=172800
COLECTIVOS_EXTERNAL_LINK_MAX_TTL_SECONDS=604800
# Compatibilidad exclusiva con flujos heredados expresados en días.
COLECTIVOS_EXTERNAL_LINK_DAYS=2
COLECTIVOS_EXTERNAL_LINK_MAX_DAYS=30
# Doble confirmación local para la prueba sintética. Mantener cerrada por defecto.
COLECTIVOS_TASK_PUBLISH_ENABLED=false
COLECTIVOS_TASK_WRITE_CONFIRMATION=
COLECTIVOS_EXTERNAL_CONTACT_CHANNEL=Contacte a la persona de A&S que compartio este enlace.
COLECTIVOS_EXTERNAL_SESSION_TTL_SECONDS=1800
COLECTIVOS_EXCEL_PREVIEW_TTL_SECONDS=1800
COLECTIVOS_DEADLINES_ENABLED=true
COLECTIVOS_DEADLINE_REMINDER_DAYS=3
COLECTIVOS_DEADLINE_BATCH_LIMIT=200
COLECTIVOS_DEADLINE_EMAIL_ENABLED=true
COLECTIVOS_DEADLINE_INTERNAL_EMAIL=
COLECTIVOS_ATTACHMENT_MAX_BYTES=10485760
COLECTIVOS_ATTACHMENT_TOTAL_BYTES=26214400
COLECTIVOS_EXTERNAL_BASE_URL=http://127.0.0.1:8000
# Acceso temporal de QA al modulo interno; desactivar al conectar la autenticacion heredada.
COLECTIVOS_INTERNAL_PUBLIC_ACCESS=true
COLECTIVOS_TECHNICAL_ACTOR_USERNAME=colectivos-technical
COLECTIVOS_ORGANIZATION_CACHE_TTL_SECONDS=300
COLECTIVOS_METADATA_CACHE_TTL_SECONDS=1800
COLECTIVOS_POLICY_PREPARATION_TTL_SECONDS=600
# Vigencia del Workspace local cifrado antes de exigir una nueva lectura de Zoho.
COLECTIVOS_POLICY_WORKSPACE_TTL_SECONDS=28800
# Lectura paginada completa del grupo de una póliza (límite defensivo, no truncamiento funcional).
COLECTIVOS_GROUP_PAGE_SIZE=200
COLECTIVOS_GROUP_MAX_RECORDS=10000
SESSION_INACTIVITY_SECONDS=600
SESSION_ACTIVITY_THROTTLE_SECONDS=60
REAUTH_TTL_SECONDS=300
MFA_FAILURE_LIMIT=5
MFA_ISSUER=CardManager

# Zoho CRM API V8 (solo lectura). Nunca versionar credenciales reales.
ZOHO_ENABLED=false
# Habilitar solo temporalmente en local; mantener false antes de producción.
ZOHO_PUBLIC_SETUP_ENABLED=false
# Selector global de todas las aplicaciones funcionales Zoho.
# Valores permitidos: sandbox, production. Sandbox es el valor seguro inicial.
ZOHO_ACTIVE_PROFILE=sandbox
# Compatibilidad temporal exclusiva de production. Migrar a ZOHO_PRODUCTION_*.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:8000/integrations/zoho/callback/
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_API_BASE_URL=https://www.zohoapis.com
# Organización, metadatos, módulos y COQL exclusivamente en lectura.
ZOHO_OAUTH_SCOPES=ZohoCRM.org.READ,ZohoCRM.settings.modules.READ,ZohoCRM.settings.fields.READ,ZohoCRM.modules.READ,ZohoCRM.coql.READ
ZOHO_REFRESH_TOKEN=
ZOHO_REQUEST_TIMEOUT_SECONDS=15
ZOHO_MAX_RETRIES=2
ZOHO_BACKEND=sdk
# Caché regenerable del SDK. No contiene tokens ni debe versionarse.
ZOHO_SDK_RESOURCE_PATH=runtime/zoho_sdk
ZOHO_SDK_LOG_LEVEL=INFO

# Perfil productivo.
ZOHO_PRODUCTION_ENABLED=false
ZOHO_PRODUCTION_CLIENT_ID=
ZOHO_PRODUCTION_CLIENT_SECRET=
ZOHO_PRODUCTION_REFRESH_TOKEN=
ZOHO_PRODUCTION_EXPECTED_ORG_ID=
ZOHO_PRODUCTION_ENVIRONMENT=production
ZOHO_PRODUCTION_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_PRODUCTION_API_BASE_URL=https://www.zohoapis.com
ZOHO_PRODUCTION_WRITE_ENABLED=false
ZOHO_PRODUCTION_SDK_RESOURCE_PATH=runtime/zoho_sdk/production

# Sandbox real. Debe usar un refresh token distinto al productivo.
ZOHO_SANDBOX_ENABLED=false
ZOHO_SANDBOX_CLIENT_ID=
ZOHO_SANDBOX_CLIENT_SECRET=
ZOHO_SANDBOX_REFRESH_TOKEN=
ZOHO_SANDBOX_EXPECTED_ORG_ID=
ZOHO_SANDBOX_ENVIRONMENT=sandbox
ZOHO_SANDBOX_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_SANDBOX_API_BASE_URL=https://sandbox.zohoapis.com
ZOHO_SANDBOX_WRITE_ENABLED=false
ZOHO_SANDBOX_SDK_RESOURCE_PATH=runtime/zoho_sdk/sandbox

# Perfiles reservados; permanecen cerrados hasta configuración explícita.
ZOHO_QA_ENABLED=false
ZOHO_DEMO_ENABLED=false
ZOHO_FUTURE_ENABLED=false
