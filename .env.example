# Referencia segura para despliegue. Para desarrollo local use un .env separado.
APP_ENV=production
DEBUG=false
TOOLS_ACCESS_MODE=trusted_intranet
# Validador aprobado de la intranet; obligatorio fuera de DEBUG.
TOOLS_DELEGATED_ACCESS_VALIDATOR=intranet_sso.delegated_access.validate_intranet_session
# SSO delegado desde la intranet de WordPress (segurosays.com/intranet). Ver
# deploy/wordpress-intranet-sso/README.md para el detalle completo. En
# producción: TOOLS_ACCESS_MODE=trusted_intranet,
# TOOLS_DELEGATED_ACCESS_VALIDATOR=intranet_sso.delegated_access.validate_intranet_session
# INTRANET_SSO_PUBLIC_KEY es la clave pública (PEM) que entrega WordPress; nunca
# la clave privada. Acepta saltos de línea reales o escapados como "\n".
INTRANET_SSO_PUBLIC_KEY=
INTRANET_SSO_AUTHORIZE_URL=https://segurosays.com/intranet/wp-json/intranet-sso/v1/authorize
INTRANET_SSO_AUDIENCE=bapps.dp.segurosays.com
INTRANET_SSO_ISSUER=segurosays.com
INTRANET_SSO_ASSERTION_MAX_AGE=60
INTRANET_SSO_SESSION_MAX_AGE=2700
INTRANET_SSO_COOKIE_NAME=intranet_sso
SECRET_KEY=<GENERAR_SECRETO_DJANGO_PRODUCCION>
ALLOWED_HOSTS=<DOMINIOS_REALES_SEPARADOS_POR_COMAS>
CSRF_TRUSTED_ORIGINS=https://<DOMINIO_REAL>
DB_ENGINE=postgresql
DB_NAME=<NOMBRE_DB_PRODUCCION>
DB_USER=<USUARIO_DB_PRODUCCION>
DB_PASSWORD=<SECRETO_DB_PRODUCCION>
DB_HOST=<HOST_DB_PRODUCCION>
DB_PORT=5432
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# Secreto aleatorio independiente para detección determinística de duplicados.
FIELD_FINGERPRINT_KEY=
OFFICE_START=07:00
OFFICE_END=18:00
ALERT_EMAIL=superior@ays.example
DEFAULT_FROM_EMAIL=alertas@ays.example

# Backend general de Django en producción.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Servicio de notificaciones: console, smtp o graph.
ALERT_EMAIL_BACKEND=smtp
ALERT_EMAIL_FROM=alertas@ays.example
ALERT_EMAIL_ADMIN=administrador@ays.example
ALERT_EMAIL_LEADER=lider.cartera@ays.example

# SMTP Microsoft 365 con contraseña de aplicación. No use la contraseña normal.
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Microsoft Graph permanece disponible como alternativa futura.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER=
EMAIL_TIMEOUT_SECONDS=10
EMAIL_MAX_RETRIES=3
# Nunca suba .env a Git. Reciba y rote secretos únicamente mediante un canal seguro.
# SMTP requiere que el tenant y el buzón permitan SMTP autenticado y contraseñas de aplicación.
VAULT_BASE_URL=https://<DOMINIO_REAL>
SOAT_APP_URL=
# URL HTTPS del reporte fuente en Zoho que se muestra como enlace informativo.
SOAT_ZOHO_REPORT_URL=
SOAT_MAX_UPLOAD_BYTES=26214400
SOAT_MAX_ROWS=100000
SOAT_MAX_COLUMNS=200

# Conciliador de Facturación (módulo de conciliación de asegurados vs. cobro).
# Dejar CONCILIACION_APP_URL vacío para usar la ruta interna /conciliador/.
CONCILIACION_APP_URL=
CONCILIACION_MAX_UPLOAD_BYTES=26214400
# Diferencia en pesos por debajo de la cual una diferencia de prima cobrada vs.
# Zoho NO se reporta como incidente (ComparacionExactaRule).
CONCILIACION_UMBRAL_VALOR_EXACTO=10
# Prellenado de Certificado/Fecha expedición/Pago total cuota del Cobro en
# Zoho Producción al hacer clic en "Facturar cobro", cuando el recibo (PDF)
# se extrajo con éxito. Requiere ZOHO_PRODUCTION_WRITE_ENABLED=true. Probar en
# Sandbox antes de habilitar en Producción.
CONCILIACION_COBRO_PREFILL_ENABLED=false

# Validación del recibo (PDF) vía Azure AI Foundry. Un solo modelo compartido
# para los 3 servicios (salud, vida, movilidad) que ya tenían un analyzer de
# Content Understanding propio. La KEY es un SECRETO: nunca se versiona; su
# ausencia degrada la validación a "N/D" sin romper la conciliación.
# Endpoint/modelo tienen defaults no secretos; solo defínalos si el recurso
# difiere del de desarrollo.
AZURE_FOUNDRY_RECIBO_KEY=
AZURE_FOUNDRY_RECIBO_ENDPOINT=https://ays-cu-renovaciones-dev.services.ai.azure.com/openai/v1
AZURE_FOUNDRY_RECIBO_MODEL=gpt-5.6-luna
REPORT_XLSX_MAX_ROWS=5000
REPORT_PDF_MAX_ROWS=1000
REPORT_DEFAULT_MAX_DAYS=90
REPORT_LARGE_EXPORT_ALERT_THRESHOLD=1000
# Miniportal externo de Colectivos: vigencia funcional predeterminada de 48 horas.
COLECTIVOS_EXTERNAL_LINK_TTL_SECONDS=172800
COLECTIVOS_EXTERNAL_LINK_MAX_TTL_SECONDS=604800
# Compatibilidad exclusiva con flujos heredados expresados en días.
COLECTIVOS_EXTERNAL_LINK_DAYS=2
COLECTIVOS_EXTERNAL_LINK_MAX_DAYS=30
# Producción actual utiliza WRITE para el flujo operativo. Verifique aprobación
# antes de copiar estos valores a un entorno nuevo.
COLECTIVOS_TASK_PUBLISH_ENABLED=true
COLECTIVOS_TASK_WRITE_CONFIRMATION=
COLECTIVOS_CONTACT_PUBLISH_ENABLED=true
COLECTIVOS_SUBRISK_PUBLISH_ENABLED=true
COLECTIVOS_RISK_PUBLISH_ENABLED=true
COLECTIVOS_RISK_WRITE_CONFIRMATION=
COLECTIVOS_SUBRISK_WRITE_CONFIRMATION=
COLECTIVOS_MOBILITY_CONTACT_SEED_ENABLED=false
COLECTIVOS_MOBILITY_CONTACT_SEED_CONFIRMATION=
COLECTIVOS_MOBILITY_RISK_SEED_ENABLED=false
COLECTIVOS_MOBILITY_RISK_SEED_CONFIRMATION=
COLECTIVOS_MOBILITY_SUBRISK_SEED_ENABLED=false
COLECTIVOS_MOBILITY_SUBRISK_SEED_CONFIRMATION=
COLECTIVOS_CONTACT_WRITE_CONFIRMATION=
COLECTIVOS_SANDBOX_TASK_WRITE_CONFIRMATION=SANDBOX_TASK_WRITE
COLECTIVOS_PRODUCTION_TASK_WRITE_CONFIRMATION=PRODUCTION_TASK_WRITE
COLECTIVOS_SANDBOX_CONTACT_WRITE_CONFIRMATION=SANDBOX_CONTACT_WRITE
COLECTIVOS_PRODUCTION_CONTACT_WRITE_CONFIRMATION=PRODUCTION_CONTACT_WRITE
COLECTIVOS_SANDBOX_RISK_WRITE_CONFIRMATION=SANDBOX_RISK_WRITE
COLECTIVOS_PRODUCTION_RISK_WRITE_CONFIRMATION=PRODUCTION_RISK_WRITE
COLECTIVOS_SANDBOX_SUBRISK_WRITE_CONFIRMATION=SANDBOX_SUBRISK_WRITE
COLECTIVOS_PRODUCTION_SUBRISK_WRITE_CONFIRMATION=PRODUCTION_SUBRISK_WRITE
COLECTIVOS_EXTERNAL_CONTACT_CHANNEL=Contacte a la persona de A&S que compartio este enlace.
COLECTIVOS_EXTERNAL_OTP_TTL_SECONDS=600
COLECTIVOS_EXTERNAL_OTP_MAX_ATTEMPTS=5
COLECTIVOS_EXTERNAL_SESSION_TTL_SECONDS=1800
COLECTIVOS_EXCEL_PREVIEW_TTL_SECONDS=1800
COLECTIVOS_DEADLINES_ENABLED=true
COLECTIVOS_DEADLINE_REMINDER_DAYS=3
COLECTIVOS_DEADLINE_BATCH_LIMIT=200
COLECTIVOS_DEADLINE_EMAIL_ENABLED=true
COLECTIVOS_DEADLINE_INTERNAL_EMAIL=
COLECTIVOS_ATTACHMENT_MAX_BYTES=10485760
COLECTIVOS_ATTACHMENT_TOTAL_BYTES=26214400
COLECTIVOS_ATTACHMENT_PUBLISH_ENABLED=true
COLECTIVOS_ATTACHMENT_WRITE_CONFIRMATION=
COLECTIVOS_SANDBOX_ATTACHMENT_WRITE_CONFIRMATION=SANDBOX_ATTACHMENT_WRITE
COLECTIVOS_PRODUCTION_ATTACHMENT_WRITE_CONFIRMATION=PRODUCTION_ATTACHMENT_WRITE
COLECTIVOS_EXTERNAL_BASE_URL=https://<DOMINIO_REAL>
# Acceso temporal de QA al modulo interno; desactivar al conectar la autenticacion heredada.
COLECTIVOS_INTERNAL_PUBLIC_ACCESS=false
COLECTIVOS_TECHNICAL_ACTOR_USERNAME=colectivos-technical
# Renovaciones colectivas: ventana de lectura, alerta visual y límite por corrida.
COLECTIVOS_RENEWAL_WINDOW_DAYS=30
COLECTIVOS_RENEWAL_ALERT_DAYS=10
COLECTIVOS_RENEWAL_BATCH_LIMIT=100
COLECTIVOS_RENEWAL_READ_CACHE_SECONDS=60
COLECTIVOS_RENEWAL_LINK_TTL_DAYS=8
COLECTIVOS_RENEWAL_REMINDER_DAYS=3
COLECTIVOS_RENEWAL_EMAIL_HOST=smtp.office365.com
COLECTIVOS_RENEWAL_EMAIL_PORT=587
COLECTIVOS_RENEWAL_EMAIL_USE_TLS=true
COLECTIVOS_RENEWAL_EMAIL_USER=gestionbeneficios@segurosays.com
COLECTIVOS_RENEWAL_EMAIL_PASSWORD=<CONFIGURAR_APP_PASSWORD_EN_PRODUCCION>
COLECTIVOS_RENEWAL_EMAIL_FROM=gestionbeneficios@segurosays.com
COLECTIVOS_ORGANIZATION_CACHE_TTL_SECONDS=300
COLECTIVOS_METADATA_CACHE_TTL_SECONDS=1800
COLECTIVOS_POLICY_PREPARATION_TTL_SECONDS=600
# Vigencia del Workspace local cifrado antes de exigir una nueva lectura de Zoho.
COLECTIVOS_POLICY_WORKSPACE_TTL_SECONDS=28800
# Lectura paginada completa del grupo de una póliza (límite defensivo, no truncamiento funcional).
COLECTIVOS_GROUP_PAGE_SIZE=200
COLECTIVOS_GROUP_MAX_RECORDS=10000
SESSION_INACTIVITY_SECONDS=600
SESSION_ACTIVITY_THROTTLE_SECONDS=60
REAUTH_TTL_SECONDS=300
MFA_FAILURE_LIMIT=5
MFA_ISSUER=CardManager

# Zoho CRM API V8 (solo lectura). Nunca versionar credenciales reales.
ZOHO_ENABLED=false
# Habilitar solo temporalmente en local; mantener false antes de producción.
ZOHO_PUBLIC_SETUP_ENABLED=false
# Selector global de todas las aplicaciones funcionales Zoho.
# Valores permitidos: sandbox, production. Sandbox es el valor seguro inicial.
ZOHO_ACTIVE_PROFILE=sandbox
# Compatibilidad temporal exclusiva de production. Migrar a ZOHO_PRODUCTION_*.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:8000/integrations/zoho/callback/
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_API_BASE_URL=https://www.zohoapis.com
# Organización, metadatos, módulos y COQL exclusivamente en lectura.
ZOHO_OAUTH_SCOPES=ZohoCRM.org.READ,ZohoCRM.settings.modules.READ,ZohoCRM.settings.fields.READ,ZohoCRM.modules.READ,ZohoCRM.coql.READ
ZOHO_REFRESH_TOKEN=
ZOHO_REQUEST_TIMEOUT_SECONDS=15
ZOHO_MAX_RETRIES=2
ZOHO_BACKEND=sdk
# Caché regenerable del SDK. No contiene tokens ni debe versionarse.
ZOHO_SDK_RESOURCE_PATH=runtime/zoho_sdk
ZOHO_SDK_LOG_LEVEL=INFO

# Perfil productivo.
ZOHO_PRODUCTION_ENABLED=true
ZOHO_PRODUCTION_CLIENT_ID=
ZOHO_PRODUCTION_CLIENT_SECRET=
ZOHO_PRODUCTION_REFRESH_TOKEN=
ZOHO_PRODUCTION_EXPECTED_ORG_ID=
ZOHO_PRODUCTION_ENVIRONMENT=production
ZOHO_PRODUCTION_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_PRODUCTION_API_BASE_URL=https://www.zohoapis.com
ZOHO_PRODUCTION_WRITE_ENABLED=true
ZOHO_PRODUCTION_SDK_RESOURCE_PATH=runtime/zoho_sdk/production

# Sandbox real. Debe usar un refresh token distinto al productivo.
ZOHO_SANDBOX_ENABLED=false
ZOHO_SANDBOX_CLIENT_ID=
ZOHO_SANDBOX_CLIENT_SECRET=
ZOHO_SANDBOX_REFRESH_TOKEN=
ZOHO_SANDBOX_EXPECTED_ORG_ID=
ZOHO_SANDBOX_ENVIRONMENT=sandbox
ZOHO_SANDBOX_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_SANDBOX_API_BASE_URL=https://sandbox.zohoapis.com
ZOHO_SANDBOX_WRITE_ENABLED=false
ZOHO_SANDBOX_SDK_RESOURCE_PATH=runtime/zoho_sdk/sandbox

# Perfiles reservados; permanecen cerrados hasta configuración explícita.
ZOHO_QA_ENABLED=false
ZOHO_DEMO_ENABLED=false
ZOHO_FUTURE_ENABLED=false
